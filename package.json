{
  "name": "utils.plus",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run data && vite",
    "build": "npm run data && rm -rf ./dist && tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "fmt": "dprint fmt --config conf/dprint.json",
    "fmt:check": "dprint check --config conf/dprint.json",
    "vitest": "npm run data && vitest run",
    "vitest:watch": "npm run data && vitest",
    "playwright": "playwright test --config conf/playwright.config.ts",
    "attributions": "node scripts/generate-attributions.mjs",
    "attributions:check": "node scripts/generate-attributions.mjs --check",
    "phone-geo": "node scripts/generate-phone-geo.mjs",
    "country-shapes": "node scripts/generate-country-shapes.mjs",
    "data": "npm run phone-geo && npm run country-shapes",
    "outdated": "node scripts/outdated.mjs",
    "check": "npm run data && npm run fmt:check && npm run typecheck && npm run attributions:check",
    "test": "npm run check && npm run vitest && npm run build"
  },
